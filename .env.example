# EAC Portal Credentials (https://meterreading-dso.eac.com.cy)
EAC_EMAIL=your_email@example.com
EAC_PASSWORD=your_password_here

# Optional: Service Point ID (if you have multiple meters).
# If left empty, the application auto-discovers and uses your primary meter.
# EAC_SP_ID=

# Fetch interval when running in background loop mode (-loop)
# Examples: 1h, 6h, 12h, 24h
FETCH_INTERVAL=12h

# Number of days back to download for the report
DAYS_BACK=7

# Number of highest peak intervals to display in the console
TOP_INTERVALS=10

# Directory to store downloaded Excel files and HTML reports
DATA_DIR=./data

# Whether to generate an interactive HTML report with Chart.js
GENERATE_HTML=true
